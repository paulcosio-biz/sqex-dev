<style>

    .payment-icon-container {
  width: 38px;
  height: 24px;
}
.payment-icon-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.payment-note {
  margin-top: var(--product-info-gap);
  color: #666;
}

</style>


<ul class="payment-methods unstyled-list">

  {% for type in shop.enabled_payment_types %}
    <li>
      {{ type | payment_type_svg_tag }}
    </li>
  {% endfor %}

    <!-- Global-e custom payment icons -->

