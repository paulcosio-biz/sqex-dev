        "liquid": "<section class=\"custom-media-banner custom-media-banner--ff7\">\n  <div class=\"custom-media-banner__inner\">\n\n    <!-- Banner 1 -->\n    <div class=\"custom-media-banner__media\">\n      <a href=\"https://apac.store.square-enix.com/collections/final-fantasy-xiv-original-soundtrack\" title=\"FF14 Original Soundtrack\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0666/0974/1893/files/PC_FF14ST_2_S.png?v=1782353794\"\n          alt=\"FF14 Original Soundtrack\"\n          loading=\"lazy\"\n        >\n      </a>\n    </div>\n\n    <!-- Banner 2 -->\n    <div class=\"custom-media-banner__media\">\n      <a href=\"https://apac.store.square-enix.com/products/final-fantasy-xiv-grand-companies-of-eorzea-medal-brooch-set\" title=\"FF14 Brooch\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0666/0974/1893/files/4_PC_FF14Brooch_906x400_a7b39c48-8720-408e-a723-034fb6507dc3.png?v=1776305325\"\n          alt=\"FF14 Brooch Banner\"\n          loading=\"lazy\"\n        >\n      </a>\n    </div>\n\n    <!-- Banner 3 -->\n    <div class=\"custom-media-banner__media\">\n      <a href=\"https://apac.store.square-enix.com/search?q=FINAL+FANTASY+IX+ADORABLE+ARTS\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0666/0974/1893/files/2_PC_FF9ARTS_906x400_f3101eef-6752-4c3f-a730-dcfe4c8e3b76.png?v=1780023228\"\n          alt=\"FF9 Arts Banner\"\n          loading=\"lazy\"\n        >\n      </a>\n    </div>\n\n    <!-- Banner 4 -->\n    <div class=\"custom-media-banner__media\">\n      <a href=\"https://apac.store.square-enix.com/collections/nier-soundtrack\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0666/0974/1893/files/5_PC_NieR-CDLP._906x400_69ff2f12-6d27-4cb0-8e8a-0dc77f976106.png?v=1780023228\"\n          alt=\"NieR CDLP Banner\"\n          loading=\"lazy\"\n        >\n      </a>\n    </div>\n\n  </div>\n</section>\n\n<style>\n  /* 🔒 Scoped */\n  .custom-media-banner--ff7 {\n    padding: 0;\n    display: flex;\n    justify-content: center;\n  }\n\n  /* 2-column layout */\n  .custom-media-banner--ff7 .custom-media-banner__inner {\n    display: grid;\n    grid-template-columns: repeat(2, auto); \n    justify-content: center;\n    gap: 20px;\n  }\n\n  .custom-media-banner--ff7 .custom-media-banner__media img {\n    display: block;\n    width: auto;\n    height: auto;\n    border-radius: 0;\n    max-width: 100%;\n  }\n\n  /* Desktop */\n  @media (min-width: 700px) {\n    .custom-media-banner--ff7 .custom-media-banner__media img {\n    width: 500px;\n    max-width: 100%;\n    margin: 0 auto;\n    }\n  }\n\n  /* Mobile: stack again */\n  @media (max-width: 699px) {\n    .custom-media-banner--ff7 .custom-media-banner__inner {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    .custom-media-banner--ff7 .custom-media-banner__media img {\n      width: 100%;\n      transform: scale(1.02);\n      transform-origin: center;\n    }\n\n  }\n\n.custom-media-banner__media {\npadding-bottom: 0px !important;\n}\n</style>",
