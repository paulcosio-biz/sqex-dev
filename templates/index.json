    "custom_liquid_k8g3qB": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Most Popular",
      "settings": {
        "color_scheme": "scheme-2",
        "separate_section_with_border": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<style>\n\n/* Grid layout */\n.mp-section {\n  display: grid;\n  grid-template-columns: 2fr 1.5fr 1.5fr;\n      gap: var(--section-stack-gap);\n  align-items: start;\n}\n\n/* Section title *\n\n/* Card styles */\n.mp-card {\n  display: flex;\n  flex-direction: column;\n  text-decoration: none;\n  color: inherit;\n  position: relative;\n}\n\n/* Image container */\n.mp-card__img-container {\n  width: 100%;\n  overflow: hidden;\n  border-radius: 4px;\n  flex-shrink: 0;\n}\n\n/* Image itself */\n.mp-card__img-container img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n/* Card info */\n.mp-card__info {\n  margin-top: 8px;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-start;\n  text-align: left;\n}\n\n/* Vendor and name text */\n.mp-card__vendor {\n  font-size: 12px;\n  color: #777;\n}\n\n.mp-card__name {\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.3;\n}\n\n/* Top badges */\n .mp-section .badge {\n  position: absolute;\n  top: 10px;\n  left: 0px;\n  background: black;\n  color: #fff;\n  font-weight: bold;\n  border-radius: 0px;\n  padding: 2px 25px;\n  font-size: 12px;\n  clip-path: polygon(\n    0 0,\n    100% 0,\n    90% 50%,\n    100% 100%,\n    0 100%\n  );\n}\n\n .mp-section .badge.top1 {\n  font-size: 16px;\n  padding: 2px 35px;\n}\n\n/* Stacked columns */\n.mp-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 20px 20px;\n}\n\n/* Align text to top */\n.mp-stack .mp-card__info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-start;\n  overflow: hidden;\n}\n\n/* Column 2 (Top 1) */\n#top-seller-col2 {\n  display: flex;\n  flex-direction: column;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n /* Make card flow vertically */\n  .mp-card {\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* Badge on mobile: move above the image */\n   .mp-section .badge {\n    position: static !important;   /* remove absolute positioning */\n    order: -1;      \n  display: inline-block;                 /* put it before the image */\n    margin-bottom: 6px;            /* space below badge */\n    width: 120px;                    /* don't clip */\n    padding: 2px 2px !important;              /* adjust padding for mobile */\n    font-size: 12px;                /* adjust font if needed */\n  }\n\n  /* Keep images square */\n  .mp-card__img-container {\n    aspect-ratio: 1 / 1;\n    height: auto !important;\n  }\n  .mp-section {\n    grid-template-columns: 1fr;\n  }\n  .mp-section__title {\n    font-size: 36px;\n    padding-right: 0;\n  }\n  .mp-stack {\n    flex-direction: row;\n    gap: 8px;\n  }\n  .mp-stack .mp-card {\n    flex: 1;\n  }\n\n  /* Make images square (1:1) */\n  .mp-card__img-container {\n    aspect-ratio: 1 / 1;\n    height: auto !important;\n  }\n}\n\n</style>\n\n<div class=\"mp-section\">\n<div style=\"grid-column: 1 / -1;\">\n  <div class=\"v-stack justify-self-center gap-4 text-center sm:gap-5\">\n    <h2 class=\"h2\">Most Popular</h2>\n  </div>\n</div>\n  <div id=\"top-seller-col2\"></div>\n  <div class=\"mp-stack\" id=\"top-seller-col3\"></div>\n  <div class=\"mp-stack\" id=\"top-seller-col4\"></div>\n</div>\n\n<script>\nfetch('https://apac.store.square-enix.com/collections/top-seller/products.json')\n.then(res => res.json())\n.then(data => {\n  const products = data.products;\n  const col1 = document.getElementById('top-seller-col2'); // Top 1\n  const col2 = document.getElementById('top-seller-col3'); // Top 2 + Top 4\n  const col3 = document.getElementById('top-seller-col4'); // Top 3 + Top 5\n\n  // Create cards\n  const cardTop1 = createCard(products[0], 0);\n  const cardTop2 = createCard(products[1], 1);\n  const cardTop3 = createCard(products[2], 2);\n  const cardTop4 = createCard(products[3], 3);\n  const cardTop5 = createCard(products[4], 4);\n\n  // Append cards to correct columns\n  col1.appendChild(cardTop1);\n  col2.appendChild(cardTop2);\n  col2.appendChild(cardTop4);\n  col3.appendChild(cardTop3);\n  col3.appendChild(cardTop5);\n\n  // Function to adjust image heights proportionally and align total card heights\n  function adjustHeights() {\n    const top1Img = cardTop1.querySelector('.mp-card__img-container');\n    const top1Height = top1Img.offsetHeight;\n\n    // Set Top 2-5 image containers to 40% of Top 1 height\n    const shortHeight = top1Height * 0.45;\n    [cardTop2, cardTop3, cardTop4, cardTop5].forEach(card => {\n      card.querySelector('.mp-card__img-container').style.height = shortHeight + 'px';\n    });\n\n    // Match total card heights for alignment\n    const maxTopRow = Math.max(cardTop2.offsetHeight, cardTop3.offsetHeight);\n    cardTop2.style.height = maxTopRow + 'px';\n    cardTop3.style.height = maxTopRow + 'px';\n\n    const maxBottomRow = Math.max(cardTop4.offsetHeight, cardTop5.offsetHeight);\n    cardTop4.style.height = maxBottomRow + 'px';\n    cardTop5.style.height = maxBottomRow + 'px';\n  }\n\n  // Wait until all images are loaded\n  const allImages = document.querySelectorAll('.mp-card img');\n  let loadedCount = 0;\n  allImages.forEach(img => {\n    if (img.complete) loadedCount++;\n    else img.onload = () => { \n      loadedCount++; \n      if(loadedCount === allImages.length) adjustHeights(); \n    };\n  });\n  if (loadedCount === allImages.length) adjustHeights();\n\n  window.addEventListener('resize', adjustHeights);\n\n  // Function to create individual product cards\n  function createCard(prod, index){\n    const img = prod.images[0]?.src || '';\n    const link = prod.url || `/products/${prod.handle}`;\n    const vendor = prod.vendor || '';\n    const name = prod.title || '';\n\n    const card = document.createElement('a');\n    card.className = 'mp-card';\n    card.href = link;\n    card.target = '_blank';\n    card.innerHTML = `\n      <div class=\"mp-card__img-container\">\n        <img src=\"${img}\" alt=\"\">\n      </div>\n      <div class=\"badge ${index === 0 ? 'top1' : ''}\">★ Top ${index+1}</div>\n      <div class=\"mp-card__info\">\n        <div class=\"mp-card__vendor\">${vendor}</div>\n        <div class=\"mp-card__name\">${name}</div>\n      </div>\n    `;\n    return card; \n  }\n}); \n</script>",
        "text_alignment": "center"
      }
    },
